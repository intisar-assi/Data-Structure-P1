// Function to add two polynomials\
Node* addPolynomials(Node* poly1, Node* poly2) \{\
    Node* result = NULL;\
\
    while (poly1 != NULL && poly2 != NULL) \{\
        Node* newNode = (Node*)malloc(sizeof(Node));// Create a new node for the result list\
\
        if (poly1->exponent > poly2->exponent) \{// If poly1's exponent is greater, take poly1's term and move to the next term\
            newNode->coefficient = poly1->coefficient;\
            newNode->exponent = poly1->exponent;\
            poly1 = poly1->next;\
        \} else if (poly1->exponent < poly2->exponent) \{// If poly2's exponent is greater, take poly2's term and move to the next term\
            newNode->coefficient = poly2->coefficient;\
            newNode->exponent = poly2->exponent;\
            poly2 = poly2->next;\
        \} else \{// If both exponents are the same, add the coefficients together\
            newNode->coefficient = poly1->coefficient + poly2->coefficient;\
            newNode->exponent = poly1->exponent;\
            poly1 = poly1->next;// Move to the next term in poly1\
            poly2 = poly2->next;// Move to the next term in poly2\
        \}\
\
        newNode->next = NULL;\
\
        // If result is NULL, the new node becomes the result\
        if (result == NULL) \{\
            result = newNode;\
        \} else \{\
            // Traverse to the end and insert the new node\
            Node* temp = result;\
            while (temp->next != NULL) \{\
                temp = temp->next;\
            \}\
            temp->next = newNode;\
        \}\
    \}\
\
    // If any terms remain in poly1 or poly2, append them\
    while (poly1 != NULL) \{\
        Node* newNode = createNode(poly1->coefficient, poly1->exponent);\
        Node* temp = result;\
        while (temp->next != NULL) \{\
            temp = temp->next;\
        \}\
        temp->next = newNode;\
        poly1 = poly1->next;\
    \}\
    // If any terms remain in poly2, append them to the result\
    while (poly2 != NULL) \{\
        Node* newNode = createNode(poly2->coefficient, poly2->exponent);\
        Node* temp = result;\
        while (temp->next != NULL) \{\
            temp = temp->next;\
        \}\
        temp->next = newNode;\
        poly2 = poly2->next;// Move to the next term in poly2\
    \}\
\
    return result;\
\}\
