// Function to multiply two polynomials\
Node* multiplyPolynomials(Node* poly1, Node* poly2) \{\
    Node* result = NULL;\
\
    // Traverse through each term of poly1\
    for (Node* p1 = poly1; p1 != NULL; p1 = p1->next) \{\
        // Traverse through each term of poly2\
        for (Node* p2 = poly2; p2 != NULL; p2 = p2->next) \{\
            int newCoeff = p1->coefficient * p2->coefficient;  // Multiply coefficients\
            int newExp = p1->exponent + p2->exponent;          // Add exponents\
\
            // Insert the product into the result polynomial\
            insertNode(&result, newCoeff, newExp);\
        \}\
    \}\
\
    Node* resultSimplified = NULL;  // Initialize an empty list for the simplified polynomial\
    Node* current = result;         // Pointer to traverse the original polynomial (result)\
\
