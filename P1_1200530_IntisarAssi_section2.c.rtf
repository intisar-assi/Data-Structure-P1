// Function to read a file and parse the polynomial\
void readFileAndParsePolynomial(const char* filename) \{\
    char line[256];\
    FILE* file = fopen(filename, "r");\
    if (file == NULL) \{\
        printf("File could not be opened.\\n");\
        return;\
    \}\
    printf("Loading polynomials from file:\\n");\
    int line_number = 1;\
    while (fgets(line, sizeof(line), file)) \{// Read each line from the file until the end of the file\
        Node* polyList = NULL;// Pointer to the linked list\
\
        line[strcspn(line, "\\n")] = 0;// Remove the newline character from the end of the line (if present)\
        // Parse the polynomial string into a linked list of terms\
        parsePolynomial(line, &polyList);\
         // Push the parsed polynomial list onto some stack\
        push(polyList);\
        printf("Polynomial %d loaded.\\n", line_number);\
        line_number++;\
    \}\
    fclose(file);\
\}\
