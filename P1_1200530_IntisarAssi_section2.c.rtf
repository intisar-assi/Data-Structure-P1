//  node structure for polynomial terms\
typedef struct Node \{\
    int coefficient;      // Coefficient \
    int exponent;         // Exponent \
    struct Node* next;    // Pointer to the next term\
\} Node;\
\
//  stack node structure for storing polynomial pointers\
typedef struct StackNode \{\
    Node* poly;           // Pointer to a polynomial linked list\
    struct StackNode* next; // Pointer to the next stack node\
\} StackNode;\
\
StackNode* stack = NULL;  // Stack to store polynomials\
\
//  push a polynomial onto the stack\
void push(Node* poly) \{\
    StackNode* newStackNode = (StackNode*)malloc(sizeof(StackNode));\
    if (newStackNode == NULL) \{\
        printf("Memory allocation failed.\\n");\
        return;\
    \}\
    newStackNode->poly = poly;\
    newStackNode->next = stack;\
    stack = newStackNode;\
\}\
\
//  pop a polynomial from the stack\
Node* pop() \{\
    if (stack == NULL) \{\
        printf("Stack is empty.\\n");\
        return NULL;\
    \}\
    StackNode* temp = stack;\
    Node* poly = temp->poly;\
    stack = stack->next;\
    free(temp);\
    return poly;\
\}\
\
// create a new polynomial term node\
Node* createNode(int coefficient, int exponent) \{\
    Node* newNode = (Node*)malloc(sizeof(Node));\
    if (newNode == NULL) \{\
        printf("Memory allocation failed.\\n");\
        return NULL;\
    \}\
    newNode->coefficient = coefficient;\
    newNode->exponent = exponent;\
    newNode->next = NULL;\
    return newNode;\
\}\
\
// Function to insert a node at the end of the polynomial linked list\
void insertNode(Node** head, int coefficient, int exponent) \{\
    Node* newNode = createNode(coefficient, exponent);\
    if (*head == NULL) \{\
        *head = newNode;\
    \} else \{\
        Node* temp = *head;\
        while (temp->next != NULL) \{\
            temp = temp->next;\
        \}\
        temp->next = newNode;\
    \}\
\}\
\
// parse and add terms from a polynomial string to the linked list\
void parsePolynomial(const char* equation, Node** polyList) \{\
    int i = 0, sign = 1;\
\
    while (equation[i] != '\\0') \{\
        int coefficient = 1;\
        int exponent = 0;\
\
        if (equation[i] == '-') \{\
            sign = -1;\
            i++;\
        \} else if (equation[i] == '+') \{\
            sign = 1;\
            i++;\
        \}\
\
        if (isdigit(equation[i])) \{\
            coefficient = sign * atoi(&equation[i]);\
            while (isdigit(equation[i])) i++;\
        \} else if (equation[i] == 'x') \{\
            coefficient = sign;\
        \}\
\
        if (equation[i] == 'x') \{\
            i++;\
            if (equation[i] == '^') \{\
                i++;\
                exponent = atoi(&equation[i]);\
                while (isdigit(equation[i])) i++;\
            \} else \{\
                exponent = 1;\
            \}\
        \} else \{\
            exponent = 0;\
        \}\
\
        insertNode(polyList, coefficient, exponent);\
    \}\
\}\
\
//  display the polynomial linked list\
void displayPolynomial(const Node* polyList) \{\
    const Node* current = polyList;\
    int isFirstTerm = 1;\
\
    while (current != NULL) \{\
        if (current->coefficient > 0 && !isFirstTerm) \{\
            printf(" + ");// If the coefficient is positive and it's not the first term, print '+'\
        \} else if (current->coefficient < 0) \{\
            printf(" - "); // If the coefficient is negative, print '-'\
        \}\
\
        if (abs(current->coefficient) != 1 || current->exponent == 0) \{\
            printf("%d", abs(current->coefficient));//absolute value of coeff\
        \}\
\
        if (current->exponent > 0) \{\
            printf("x");\
            if (current->exponent > 1) \{\
                printf("^%d", current->exponent);\
            \}\
        \}\
\
        current = current->next;\
        isFirstTerm = 0;\
    \}\
    printf("\\n");\
\}\
\
// Function to free the memory allocated for the polynomial linked list\
void freePolynomial(Node* polyList) \{\
    while (polyList != NULL) \{\
        Node* temp = polyList;\
        polyList = polyList->next;\
        free(temp);\
    \}\
\}\
