        Node* temp = resultSimplified;  // Start from the beginning of the simplified polynomial\
        Node* prev = NULL;              // Pointer to keep track of the previous node in the simplified list\
        int found = 0;                  // Flag to check if a term with the same exponent is found in resultSimplified\
